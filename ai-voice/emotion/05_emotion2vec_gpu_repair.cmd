@echo off
setlocal
set "SELF=%~f0"
set "SHFILE=%TEMP%\rensei_emotion_gpu_repair_%RANDOM%_%RANDOM%.sh"
powershell.exe -NoProfile -Command "$l=Get-Content -LiteralPath $env:SELF -Encoding ASCII; $m=[Array]::IndexOf($l,':SHPAYLOAD'); if($m -lt 0){exit 90}; $b=($l[($m+1)..($l.Length-1)] -join ''); [IO.File]::WriteAllBytes($env:SHFILE,[Convert]::FromBase64String($b)); $u=(& wsl.exe wslpath -u $env:SHFILE).Trim(); if(-not $u){exit 91}; & wsl.exe -e bash $u; exit $LASTEXITCODE"
set "RC=%ERRORLEVEL%"
del /q "%SHFILE%" >nul 2>&1
echo.
if "%RC%"=="0" (
  echo Emotion2vec GPU repair completed successfully.
) else (
  echo Emotion2vec GPU repair failed. No audio, selection, or reference data was intentionally changed.
)
pause
exit /b %RC%
:SHPAYLOAD

