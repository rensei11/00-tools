@echo off
setlocal
set "SELF=%~f0"
set "PS1FILE=%~dp0rensei_wuwa_known_wem_recovery_%RANDOM%_%RANDOM%.ps1"
powershell.exe -NoProfile -Command "$l=Get-Content -LiteralPath $env:SELF -Encoding ASCII; $m=[Array]::IndexOf($l,':PSPAYLOAD'); if($m -lt 0){exit 90}; $b=($l[($m+1)..($l.Length-1)] -join ''); [IO.File]::WriteAllBytes($env:PS1FILE,[Convert]::FromBase64String($b))"
if errorlevel 1 exit /b 90
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%PS1FILE%"
set "RC=%ERRORLEVEL%"
del /q "%PS1FILE%" >nul 2>&1
pause
exit /b %RC%
:PSPAYLOAD

