+def voice_page_identity(url: str) -> tuple[str, str]:
+    parsed = urlparse(str(url or "").strip())
+    host = (parsed.hostname or "").casefold()
+    path = unquote(parsed.path).rstrip("/")
+    match = re.search(
+        r"/wiki/(.+?)(?:/Voice-Overs/Japanese|/Voicelines/Japanese|/Voice-Overs)?$",
+        path,
+        re.I,
+    )
+    owner = normalized_words(match.group(1).replace("_", " ")) if match else ""
+    return host, owner
