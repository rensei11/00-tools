 def normalized_words(value: str) -> str:
     return re.sub(r"[^0-9a-z]+", " ", unquote(str(value)).casefold()).strip()
 
+
+def normalized_character_title(value: str) -> str:
+    return re.sub(
+        r"[\W_]+",
+        "",
+        unquote(str(value or "")).replace("_", " ").casefold(),
+        flags=re.UNICODE,
+    )
